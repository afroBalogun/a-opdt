# ─────────────────────────────────────────────────────────────────────────────
# A-OPDT hosted configuration — PDT'S OWN CLOUD ACCOUNTS.
#
# Copy to .env.cloud and fill in. Selected with A_OPDT_ENV_FILE=.env.cloud;
# unset, the twin and the webapp run entirely on localhost.
#
# These must be SEPARATE accounts from merged-asdt's (the SDT stack), not just
# separate buckets on the same one. Every free tier below is one-per-account, so
# separate accounts means a different signup email for each provider - there is
# no way to have two free InfluxDB orgs or two Aura instances under one login.
#
# What separate accounts buy: independent quotas (SDT filling its 30 MB Redis or
# 512 MB Atlas cannot starve PDT), independent credentials (rotating one never
# touches the other), and independent blast radius.
#
# What they cost: two of everything to provision, monitor and pay for if either
# outgrows free. If that trade stops being worth it, the shared-account variant
# is in git history - the data was already separated by bucket and database.
# ─────────────────────────────────────────────────────────────────────────────

# ── Asset identity (unchanged from local) ────────────────────────────────────
DT_ASSET_ID=maize_farm_001
DT_ASSET_TYPE=organic_plant_digital_twin
DT_ASSET_NAME=A-OPDT Maize Farm 001

# ── MQTT — HiveMQ Cloud, TLS only on 8883 ────────────────────────────────────
#   https://console.hivemq.cloud → Create cluster → Access Management → add a
#   credential. Note the cluster URL; it is not guessable from the account.
#   The pod bridge publishes pod/pod_01/telemetry here, so this cluster must be
#   the one CLOUD_PDT_ENV_FILE points at in ~/sensors/tools/pod_bridge.py.
DT_MQTT__BROKER=xxxxxxxx.s1.eu.hivemq.cloud
DT_MQTT__PORT=8883
DT_MQTT__USERNAME=
DT_MQTT__PASSWORD=
DT_MQTT__TLS=true

# ── InfluxDB Cloud Serverless — free, no card ────────────────────────────────
#   https://cloud2.influxdata.com → Load Data → Buckets → create maize_telemetry
#   then API Tokens → generate. Scope it to that bucket only; an all-access
#   token in a file on a laptop is worth avoiding when a scoped one does.
#   The org name is the one shown in the URL after /orgs/.
DT_INFLUX__URL=https://us-east-1-1.aws.cloud2.influxdata.com
DT_INFLUX__TOKEN=
DT_INFLUX__ORG=
DT_INFLUX__BUCKET=maize_telemetry

# ── MongoDB Atlas M0 — free, no card ─────────────────────────────────────────
#   https://cloud.mongodb.com → new project → Create free M0 →
#   Database Access: add a user → Network Access: 0.0.0.0/0
#   NOTE: Atlas speaks port 27017, which some networks block outbound. If
#   log_event warnings appear on one network and not another, that is why.
DT_MONGO__URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DT_MONGO__DB=a_opdt

# ── Redis Cloud free 30 MB — no card ─────────────────────────────────────────
#   https://redis.io/try-free
#   Redis is a cache here, not a system of record - the durable data is in
#   InfluxDB and Atlas. But do not leave it pointing at a dead endpoint:
#   RedisAdapter swallows connection errors, get_latest_cached() returns None,
#   and the webapp reads that as `or "germination"` - so a dead Redis shows a
#   wrong growth stage on the dashboard rather than an error. Localhost is a
#   better fallback than a stale hostname.
DT_REDIS__URL=redis://default:PASSWORD@redis-xxxxx.c1.eu-west-1-2.ec2.redns.redis-cloud.com:12345

# ── Neo4j AuraDB Free — no card ──────────────────────────────────────────────
#   https://console.neo4j.io → New instance → AuraDB Free
#   The generated password is shown once. Aura Free allows a single database
#   per account, which is the main reason PDT needs its own account rather than
#   sharing SDT's - although dyon's labels (Component, FailureMode, Symptom,
#   MaintenanceAction) do not actually collide with SDT's, and setup_from_spec
#   is MERGE-only, so sharing was safe when we tested it.
DT_NEO4J__URI=neo4j+s://xxxxxxxx.databases.neo4j.io
DT_NEO4J__USER=neo4j
DT_NEO4J__PASSWORD=

# ── Eclipse Ditto — not hosted ───────────────────────────────────────────────
#   Ditto has no free managed offering. The a-opdt-ditto-* containers serve it
#   on 8080; `docker compose up -d ditto-nginx ditto-gateway ditto-things
#   ditto-policies ditto-mongodb` starts them. The Thing representation is then
#   local-only and should be described as such.
DT_DITTO__URL=http://localhost:8080
DT_DITTO__USER=ditto
DT_DITTO__PASSWORD=ditto
DT_DITTO__NAMESPACE=org.aopdt

# ── LLM ──────────────────────────────────────────────────────────────────────
DT_LLM__PROVIDER=anthropic
DT_LLM__MODEL=claude-sonnet-4-6
DT_LLM__API_KEY=

# ── API server ───────────────────────────────────────────────────────────────
DT_API_PORT=8500

# ── Physical pod ─────────────────────────────────────────────────────────────
# Subscribes to the ESP32 node's topic and replaces the three fields it
# measures. The pod bridge must be publishing to THIS cluster for it to see
# anything; otherwise the twin runs fully simulated and says so in the log.
A_OPDT_PHYSICAL_POD=true
